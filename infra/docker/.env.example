# Development only. Copy this file to .env and replace the credentials.
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=evflow
POSTGRES_USER=evflow
POSTGRES_PASSWORD=evflow-local-password
POSTGRES_PORT=5432
REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379
MINIO_IMAGE=bitnamilegacy/minio:latest
S3_CLIENT_IMAGE=amazon/aws-cli:latest
MINIO_ROOT_USER=evflow-local
MINIO_ROOT_PASSWORD=evflow-local-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_PRIVATE=evflow-private
S3_BUCKET_EXPORTS=evflow-exports
