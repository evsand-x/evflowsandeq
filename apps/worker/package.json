{
  "name": "@evflow/worker",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "@evflow/backend": "workspace:*",
    "@evflow/config": "workspace:*",
    "@evflow/database": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "bullmq": "5.58.5",
    "ioredis": "5.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "dotenv-cli": "8.0.0",
    "tsx": "4.20.5"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
