# Runtime
NODE_ENV=development
API_PORT=3001
OFFICE_PORT=3000
FIELD_PORT=3002
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# PostgreSQL (development only)
POSTGRES_DB=evflow
POSTGRES_USER=evflow
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://evflow:replace-with-a-local-password@127.0.0.1:5432/evflow?schema=public

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Private S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=evflow-local
S3_SECRET_ACCESS_KEY=replace-with-a-local-password
S3_BUCKET_PRIVATE=evflow-private
S3_FORCE_PATH_STYLE=true

# Auth placeholders for Milestone 1. Replace locally; never commit real secrets.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-other-random-characters
JWT_ISSUER=evflow-local
JWT_AUDIENCE=evflow-apps
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
APP_ORIGINS=http://localhost:3000,http://localhost:3002

# Optional fictitious test-data seed. Leave empty to keep the seeded account disabled.
DEV_SEED_ADMIN_PASSWORD=
