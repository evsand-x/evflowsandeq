  },
  {
    "code": "OPS-FIN-06",
    "name": "Lama penyimpanan pesanan setelah pembayaran di muka",
    "group": "finance",
    "domain": "finance",
    "type": "object",
    "unit": "business_duration",
    "default": {
      "value": 1,
      "unit": "business_day",
      "expiry_action": "release_unpicked"
    },
    "schema": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "expiry_action",
        "working_weekdays",
        "holidays",
        "working_start",
        "cutoff"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string",
          "enum": ["business_hour", "business_day"]
        },
        "expiry_action": {
          "type": "string",
          "enum": ["release_unpicked"]
        },
        "working_weekdays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "holidays": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "working_start": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "cutoff": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      }
    }
  },
