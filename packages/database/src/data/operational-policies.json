  {
    "code": "OPS-FIN-04",
    "name": "Batas pembulatan tagihan",
    "group": "finance",
    "domain": "finance",
    "type": "object",
    "unit": "currency_amount",
    "default": {
      "amount": "1",
      "account_id": null
    },
    "schema": {
      "type": "object",
      "required": ["amount"],
      "properties": {
        "amount": {
          "type": "decimal",
          "minimum": "0"
        },
        "account_id": {
          "type": ["string", "null"]
        }
      }
    },
    "constraints": [
      {
        "kind": "required_when",
        "field": "account_id",
        "when": {
          "field": "amount",
          "operator": "decimal_gt",
          "value": "0"
        },
        "message": "Akun pembulatan wajib bila toleransi lebih dari nol."
      }
    ]
  },
  {
    "code": "OPS-FIN-05",
