  },
  {
    "code": "OPS-FIN-08",
    "name": "Kelompok umur piutang dan utang",
    "group": "finance",
    "domain": "finance",
    "type": "array",
    "unit": "day",
    "default": [
      {
        "label": "Belum jatuh tempo",
        "max": 0
      },
      {
        "label": "1–30",
        "min": 1,
        "max": 30
      },
      {
        "label": "31–60",
        "min": 31,
        "max": 60
      },
      {
        "label": "61–90",
        "min": 61,
        "max": 90
      },
      {
        "label": ">90",
        "min": 91,
        "max": null
      }
    ],
    "schema": {
      "type": "array",
      "minItems": 2
    }
  },
