  {
    "code": "OPS-FIN-04",
    "name": "Batas pembulatan tagihan",
    "group": "finance",
    "domain": "finance",
    "type": "object",
    "unit": "currency_amount",
    "default": {
      "amount": "1",
      "account_id": null
    },
    "schema": {
      "type": "object",
      "required": [
        "amount"
      ],
      "properties": {
        "amount": {
          "type": "decimal",
          "minimum": "0"
        },
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "constraints": [
      {
        "kind": "required_when",
        "field": "account_id",
        "when": {
          "field": "amount",
          "operator": "decimal_gt",
          "value": "0"
        },
        "message": "Akun pembulatan wajib bila toleransi lebih dari nol."
      }
    ]
  },
  {
    "code": "OPS-FIN-05",
    "name": "Dasar pembagian biaya tambahan barang",
    "group": "finance",
    "domain": "finance",
    "type": "string",
    "unit": null,
    "default": "net_purchase_value",
    "schema": {
      "type": "string",
      "enum": [
        "net_purchase_value",
        "weight",
        "volume",
        "quantity",
        "equal"
      ]
    }
  },
  {
    "code": "OPS-FIN-06",
    "name": "Lama penyimpanan pesanan setelah pembayaran di muka",
    "group": "finance",
    "domain": "finance",
    "type": "object",
    "unit": "business_duration",
    "default": {
      "value": 1,
      "unit": "business_day",
      "expiry_action": "release_unpicked"
    },
    "schema": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "expiry_action",
        "working_weekdays",
        "holidays",
        "working_start",
        "cutoff"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "business_hour",
            "business_day"
          ]
        },
        "expiry_action": {
          "type": "string",
          "enum": [
            "release_unpicked"
          ]
        },
        "working_weekdays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "holidays": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "working_start": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "cutoff": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      }
    }
  },
  {
    "code": "OPS-FIN-07",
