  {
    "code": "OPS-CRM-05",
    "name": "Gabungan beberapa indikator kinerja",
    "group": "crm",
    "domain": "sales",
    "type": "object",
    "unit": "percent",
    "default": {
      "enabled": false,
      "metrics": []
    },
    "schema": {
      "type": "object",
      "required": [
        "enabled",
        "metrics"
      ],
      "constraints": [
        {
          "kind": "decimal_sum_equals_when",
          "array_field": "metrics",
          "item_field": "weight",
          "expected": "100",
          "when": {
            "field": "enabled",
            "equals": true
          },
          "message": "Bobot KPI aktif harus tepat 100%."
        }
      ]
    }
  },
