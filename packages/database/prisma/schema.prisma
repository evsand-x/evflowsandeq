generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PolicyVersionState {
  ACTIVE
  SCHEDULED
  RETIRED
}

enum MasterRecordState {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductRegistrationStatus {
  PENDING
  VALID
  EXPIRED
  INVALID
}

enum MasterPriceKind {
  PURCHASE
  SALE
}

enum CustomerRelationshipStage {
  PROSPECT
  REGISTERED
  TRANSACTED
}

enum CustomerOnboardingState {
  DRAFT
  NEEDS_REVIEW
  VERIFIED
}

enum VendorType {
  COMPANY
  INDIVIDUAL
}

enum LocatorType {
  RECEIVING
  STORAGE
  QUARANTINE
  TRANSIT
  CONSIGNMENT
  DISPATCH
  RETURN
}

enum OperationalItemKind {
  SUPPLY
  ASSET_MODEL
  SERVICE
}

enum ContactState {
  ACTIVE
  INACTIVE
}

enum ProspectApproachStatus {
  NEW
  IN_PROGRESS
  POTENTIAL
  DEFERRED
  DROPPED
}

enum OpportunityState {
  DRAFT
  OPEN
  CLOSED_WON
  CLOSED_LOST
}

enum CrmActivityKind {
  NOTE
  CALL
  MEETING
  EMAIL
  FOLLOW_UP
}

enum AttachmentScanState {
  PENDING_SCAN
  AVAILABLE
  REJECTED
}

enum QuoteState {
  DRAFT
  ISSUED
  SUPERSEDED
  EXPIRED
  CANCELLED
}

enum CustomerOrderKind {
  PO
  SP
}

enum CustomerOrderState {
  DRAFT
  VERIFIED
  REJECTED
}

enum OpportunityOutcomeKind {
  WON
  LOST
}

model Company {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String
  legalName                  String?                     @map("legal_name")
  address                    String?
  phone                      String?
  email                      String?
  logoObjectKey              String?                     @map("logo_object_key")
  taxIdentity                String?                     @map("tax_identity")
  baseCurrency               String                      @default("IDR") @map("base_currency") @db.Char(3)
  timezone                   String                      @default("Asia/Makassar")
  fiscalYearStartDay         Int                         @default(1) @map("fiscal_year_start_day")
  fiscalYearStartMonth       Int                         @default(1) @map("fiscal_year_start_month")
  profileVersion             Int                         @default(1) @map("profile_version")
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                CompanyMembership[]
  roles                      Role[]
  auditEvents                AuditEvent[]
  systemPolicies             SystemPolicy[]
  productCategories          ProductCategory[]
  uoms                       Uom[]
  products                   Product[]
  customerChannels           CustomerChannel[]
  rayons                     Rayon[]
  customers                  Customer[]
  contacts                   Contact[]
  prospects                  Prospect[]
  opportunities              Opportunity[]
  crmActivities              CrmActivity[]
  attachments                Attachment[]
  quotes                     Quote[]
  customerOrders             CustomerOrder[]
  opportunityOutcomes        OpportunityOutcome[]
  suppliers                  Supplier[]
  vendors                    Vendor[]
  warehouses                 Warehouse[]
  operationalItems           OperationalItem[]
  masterCodeSequences        MasterCodeSequence[]
  stockLots                  StockLot[]
  inventoryMovements         InventoryMovement[]
  salesOrders                SalesOrder[]
  fulfillmentBatches         FulfillmentBatch[]
  deliveryReceipts           DeliveryReceipt[]
  salesInvoices              SalesInvoice[]
  customerPaymentPolicies    CustomerPaymentPolicy[]
  purchaseRequests           PurchaseRequest[]
  purchaseOrders             PurchaseOrder[]
  goodsReceipts              GoodsReceipt[]
  supplierInvoices           SupplierInvoice[]
  payableOpenItems           PayableOpenItem[]
  ledgerEntries              LedgerEntry[]
  customerReceipts           CustomerReceipt[]
  customerReceiptAllocations CustomerReceiptAllocation[]
  customerReturns            CustomerReturn[]
  creditNotes                CreditNote[]
  customerRefunds            CustomerRefund[]
  PickList                   PickList[]

  @@map("companies")
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  email             String              @unique
  passwordHash      String              @map("password_hash")
  displayName       String              @map("display_name")
  active            Boolean             @default(true)
  mfaReference      String?             @map("mfa_reference")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  passwordUpdatedAt DateTime            @default(now()) @map("password_updated_at") @db.Timestamptz(6)
  memberships       CompanyMembership[]
  auditEvents       AuditEvent[]        @relation("AuditActor")
  savedPolicies     PolicyVersion[]     @relation("PolicySavedBy")

  @@map("users")
}

model CompanyMembership {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  active    Boolean       @default(true)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  userRoles UserRole[]
  sessions  AuthSession[]

  @@unique([companyId, userId])
  @@unique([companyId, id])
  @@index([userId, active])
  @@map("company_memberships")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  code            String
  name            String
  description     String?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  membershipId String            @map("membership_id") @db.Uuid
  roleId       String            @map("role_id") @db.Uuid
  assignedAt   DateTime          @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById String?           @map("assigned_by_id") @db.Uuid
  membership   CompanyMembership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: Restrict)
  role         Role              @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([companyId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  scopeType    String     @map("scope_type")
  scopeId      String?    @map("scope_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId, scopeType, scopeId])
  @@index([companyId, roleId])
  @@map("role_permissions")
}

model AuthSession {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  membershipId      String            @map("membership_id") @db.Uuid
  sessionFamilyId   String            @unique @map("session_family_id") @db.Uuid
  deviceLabel       String?           @map("device_label")
  permissionVersion BigInt            @default(1) @map("permission_version")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt         DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?           @map("revoked_reason")
  membership        CompanyMembership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: Restrict)
  refreshTokens     RefreshToken[]

  @@index([membershipId, revokedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id                String        @id @default(uuid()) @db.Uuid
  sessionId         String        @map("session_id") @db.Uuid
  tokenHash         String        @unique @map("token_hash")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime?     @map("consumed_at") @db.Timestamptz(6)
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?       @unique @map("replaced_by_token_id") @db.Uuid
  session           AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacedBy        RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replaces          RefreshToken? @relation("TokenRotation")

  @@index([sessionId, expiresAt])
  @@map("refresh_tokens")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  beforeHash   String?  @map("before_hash")
  afterHash    String?  @map("after_hash")
  requestId    String?  @map("request_id")
  reason       String?
  metadata     Json?
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, resourceType, resourceId, occurredAt])
  @@map("audit_events")
}

model SystemPolicy {
  id                    String          @id @default(uuid()) @db.Uuid
  companyId             String          @map("company_id") @db.Uuid
  code                  String
  name                  String
  description           String?
  ownerDomain           String          @map("owner_domain")
  policyGroup           String          @map("policy_group")
  scope                 String
  valueType             String          @map("value_type")
  unit                  String?
  validationSchema      Json            @map("validation_schema")
  defaultValueSnapshot  Json            @map("default_value_snapshot")
  requiresReason        Boolean         @default(false) @map("requires_reason")
  allowsFutureEffective Boolean         @default(false) @map("allows_future_effective")
  requiresApproval      Boolean         @default(false) @map("requires_approval")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  company               Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  versions              PolicyVersion[]

  @@unique([companyId, code])
  @@map("system_policies")
}

model PolicyVersion {
  id                String             @id @default(uuid()) @db.Uuid
  policyId          String             @map("policy_id") @db.Uuid
  versionNo         Int                @map("version_no")
  valueSnapshot     Json               @map("value_snapshot")
  state             PolicyVersionState
  effectiveFrom     DateTime?          @map("effective_from") @db.Timestamptz(6)
  savedAt           DateTime           @default(now()) @map("saved_at") @db.Timestamptz(6)
  savedById         String             @map("saved_by_id") @db.Uuid
  retiredAt         DateTime?          @map("retired_at") @db.Timestamptz(6)
  reason            String?
  approvalReference String?            @map("approval_reference")
  policy            SystemPolicy       @relation(fields: [policyId], references: [id], onDelete: Restrict)
  savedBy           User               @relation("PolicySavedBy", fields: [savedById], references: [id], onDelete: Restrict)

  @@unique([policyId, versionNo])
  @@index([policyId, state, effectiveFrom])
  @@map("policy_versions")
}

model MasterCodeSequence {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  entityType String   @map("entity_type")
  nextValue  BigInt   @default(1) @map("next_value")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, entityType])
  @@map("master_code_sequences")
}

model ProductCategory {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  code           String
  name           String
  normalizedName String            @map("normalized_name")
  state          MasterRecordState @default(ACTIVE)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String            @map("created_by_id") @db.Uuid
  updatedById    String            @map("updated_by_id") @db.Uuid
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products       Product[]

  @@unique([companyId, code])
  @@unique([companyId, normalizedName])
  @@index([companyId, state, name])
  @@map("product_categories")
}

model Uom {
  id                   String                  @id @default(uuid()) @db.Uuid
  companyId            String                  @map("company_id") @db.Uuid
  code                 String
  name                 String
  normalizedName       String                  @map("normalized_name")
  state                MasterRecordState       @default(ACTIVE)
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById          String                  @map("created_by_id") @db.Uuid
  updatedById          String                  @map("updated_by_id") @db.Uuid
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  baseProducts         Product[]               @relation("ProductBaseUom")
  productUoms          ProductUom[]
  referencePrices      ProductReferencePrice[]
  operationalItems     OperationalItem[]
  prospectNeeds        ProspectNeed[]
  opportunityLines     OpportunityLine[]
  quoteLines           QuoteLine[]
  stockLots            StockLot[]
  salesOrderLines      SalesOrderLine[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]

  @@unique([companyId, code])
  @@unique([companyId, normalizedName])
  @@index([companyId, state, name])
  @@map("uoms")
}

model Product {
  id                   String                  @id @default(uuid()) @db.Uuid
  companyId            String                  @map("company_id") @db.Uuid
  code                 String
  name                 String
  normalizedName       String                  @map("normalized_name")
  categoryId           String                  @map("category_id") @db.Uuid
  baseUomId            String                  @map("base_uom_id") @db.Uuid
  batchRequired        Boolean                 @default(true) @map("batch_required")
  expiryRequired       Boolean                 @default(true) @map("expiry_required")
  serialRequired       Boolean                 @default(false) @map("serial_required")
  storageNotes         String?                 @map("storage_notes")
  storageProfile       Json?                   @map("storage_profile")
  shelfLifeDays        Int?                    @map("shelf_life_days")
  storageVerifiedAt    DateTime?               @map("storage_verified_at") @db.Timestamptz(6)
  storageVerifiedById  String?                 @map("storage_verified_by_id") @db.Uuid
  state                MasterRecordState       @default(DRAFT)
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById          String                  @map("created_by_id") @db.Uuid
  updatedById          String                  @map("updated_by_id") @db.Uuid
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category             ProductCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  baseUom              Uom                     @relation("ProductBaseUom", fields: [baseUomId], references: [id], onDelete: Restrict)
  registrations        ProductRegistration[]
  uoms                 ProductUom[]
  referencePrices      ProductReferencePrice[]
  prospectNeeds        ProspectNeed[]
  opportunityLines     OpportunityLine[]
  quoteLines           QuoteLine[]
  stockLots            StockLot[]
  salesOrderLines      SalesOrderLine[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]

  @@unique([companyId, code])
  @@unique([companyId, normalizedName])
  @@index([companyId, state, name])
  @@map("products")
}

model ProductRegistration {
  id                String                    @id @default(uuid()) @db.Uuid
  companyId         String                    @map("company_id") @db.Uuid
  productId         String                    @map("product_id") @db.Uuid
  permitType        String                    @map("permit_type")
  permitNumber      String                    @map("permit_number")
  holder            String
  issuedOn          DateTime?                 @map("issued_on") @db.Date
  expiresOn         DateTime?                 @map("expires_on") @db.Date
  status            ProductRegistrationStatus @default(PENDING)
  evidenceObjectKey String?                   @map("evidence_object_key")
  dispositionById   String?                   @map("disposition_by_id") @db.Uuid
  dispositionAt     DateTime?                 @map("disposition_at") @db.Timestamptz(6)
  dispositionReason String?                   @map("disposition_reason")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       String                    @map("created_by_id") @db.Uuid
  product           Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([companyId, permitType, permitNumber])
  @@index([companyId, productId, status])
  @@map("product_registrations")
}

model ProductUom {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  uomId         String    @map("uom_id") @db.Uuid
  factorToBase  Decimal   @map("factor_to_base") @db.Decimal(24, 10)
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  active        Boolean   @default(true)
  createdById   String    @map("created_by_id") @db.Uuid
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  uom           Uom       @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@unique([productId, uomId, effectiveFrom])
  @@index([companyId, productId, active])
  @@map("product_uoms")
}

model ProductReferencePrice {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  productId     String          @map("product_id") @db.Uuid
  uomId         String          @map("uom_id") @db.Uuid
  kind          MasterPriceKind
  currency      String          @db.Char(3)
  unitPrice     Decimal         @map("unit_price") @db.Decimal(24, 8)
  effectiveFrom DateTime        @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?       @map("effective_to") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String          @map("created_by_id") @db.Uuid
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  uom           Uom             @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@index([companyId, productId, kind, effectiveFrom])
  @@map("product_reference_prices")
}

model CustomerChannel {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  code           String
  name           String
  normalizedName String            @map("normalized_name")
  state          MasterRecordState @default(ACTIVE)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String            @map("created_by_id") @db.Uuid
  updatedById    String            @map("updated_by_id") @db.Uuid
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customers      Customer[]

  @@unique([companyId, code])
  @@unique([companyId, normalizedName])
  @@index([companyId, state, name])
  @@map("customer_channels")
}

model Rayon {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  code           String
  name           String
  normalizedName String            @map("normalized_name")
  coverageNotes  String?           @map("coverage_notes")
  state          MasterRecordState @default(ACTIVE)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String            @map("created_by_id") @db.Uuid
  updatedById    String            @map("updated_by_id") @db.Uuid
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customers      Customer[]

  @@unique([companyId, code])
  @@unique([companyId, normalizedName])
  @@index([companyId, state, name])
  @@map("rayons")
}

model Customer {
  id                String                    @id @default(uuid()) @db.Uuid
  companyId         String                    @map("company_id") @db.Uuid
  code              String
  name              String
  normalizedName    String                    @map("normalized_name")
  legalName         String?                   @map("legal_name")
  channelId         String?                   @map("channel_id") @db.Uuid
  rayonId           String?                   @map("rayon_id") @db.Uuid
  relationshipStage CustomerRelationshipStage @default(PROSPECT) @map("relationship_stage")
  onboardingState   CustomerOnboardingState   @default(DRAFT) @map("onboarding_state")
  primaryAddress    String?                   @map("primary_address")
  shippingAddress   String?                   @map("shipping_address")
  phone             String?
  email             String?
  taxIdentity       String?                   @map("tax_identity")
  taxStatus         String?                   @map("tax_status")
  billingAddress    String?                   @map("billing_address")
  customerType      String?                   @map("customer_type")
  potential         String?
  collectionSchedule String?                  @map("collection_schedule")
  invoiceExchangeSchedule String?             @map("invoice_exchange_schedule")
  paymentMethodPreference String?              @map("payment_method_preference")
  paymentToleranceDays Int?                    @map("payment_tolerance_days")
  legalDocuments    Json?                      @map("legal_documents")
  responsiblePerson Json?                      @map("responsible_person")
  responsibleLicense Json?                    @map("responsible_license")
  nooDocument       Json?                      @map("noo_document")
  // Credit attributes (stage 2b): edited only with customer_credit.update; replace CustomerPaymentPolicy.
  creditLimit       Decimal?                  @map("credit_limit") @db.Decimal(24, 8)
  creditFrozen      Boolean                   @default(false) @map("credit_frozen")
  freezeReason      String?                   @map("freeze_reason")
  pastDueGraceDays  Int?                      @map("past_due_grace_days")
  // Code from the company's active OPS-FLX-03 term list.
  defaultTermCode   String?                   @map("default_term_code")
  defaultTaxInvoiceCode String                @default("01") @map("default_tax_invoice_code") @db.Char(2)
  state             MasterRecordState         @default(DRAFT)
  version           Int                       @default(1)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
