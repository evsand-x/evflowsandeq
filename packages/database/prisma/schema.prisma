  actorId     String   @map("actor_id") @db.Uuid
  route       String
  key         String
  requestHash String   @map("request_hash")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([companyId, actorId, route, key])
  @@map("transaction_commands")
}

model TransactionEvidence {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  purpose      String
  originalName String   @map("original_name")
  objectKey    String   @map("object_key")
  sha256       String
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, purpose])
  @@map("transaction_evidence")
}

model FulfillmentDocument {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  batchId      String   @map("batch_id") @db.Uuid
  kind         String
  number       String
  snapshot     Json
  issuedById   String   @map("issued_by_id") @db.Uuid
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  @@unique([companyId, batchId, kind])
  @@unique([companyId, number])
  @@map("fulfillment_documents")
}
