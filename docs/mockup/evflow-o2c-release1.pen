     "content": "Version: 0.1 · 29 Okt 2026",
     "fontFamily": "Plus Jakarta Sans",
     "fontSize": 14,
     "fontWeight": "500",
     "fill": "$textPrimary",
     "width": "fill_container",
     "textGrowth": "fixed-width"
    },
    {
     "id": "cover-4",
     "type": "text",
     "name": "Cover 4",
     "content": "Scope in: Daftar/Form/Detail SO, Surat Jalan (draft, terbit, detail), Invoice (daftar, detail), pembayaran.",
     "fontFamily": "Plus Jakarta Sans",
     "fontSize": 14,
     "fontWeight": "400",
     "fill": "$textPrimary",
     "width": "fill_container",
     "textGrowth": "fixed-width"
    },
    {
     "id": "cover-5",
     "type": "text",
     "name": "Cover 5",
     "content": "Scope out: alokasi otomatis, picking/packing, POD, backorder, uang muka, retur, dashboard analitik.",
     "fontFamily": "Plus Jakarta Sans",
     "fontSize": 14,
     "fontWeight": "400",
     "fill": "$textPrimary",
     "width": "fill_container",
     "textGrowth": "fixed-width"
    },
    {
     "id": "cover-6",
     "type": "text",
     "name": "Cover 6",
     "content": "Brief: docs/superpowers/specs/2026-10-29-o2c-release-1-design.md",
     "fontFamily": "Plus Jakarta Sans",
     "fontSize": 13,
     "fontWeight": "400",
     "fill": "$textPrimary",
     "width": "fill_container",
     "textGrowth": "fixed-width"
    },
    {
     "id": "cover-7",
     "type": "text",
     "name": "Cover 7",
     "content": "Source of truth: kanvas Claude Design 'evflow Office Design' (interaktif). File ini adalah salinan statis untuk pencil.dev.",
     "fontFamily": "Plus Jakarta Sans",
     "fontSize": 13,
     "fontWeight": "400",
     "fill": "$textPrimary",
     "width": "fill_container",
     "textGrowth": "fixed-width"
    }
   ]
