 "children": [
  {
   "id": "cover",
   "type": "frame",
   "name": "Cover",
   "x": 0,
   "y": 0,
   "layout": "vertical",
   "gap": 12,
   "width": 1440,
   "padding": 48,
   "fill": "$surface",
   "stroke": "$border",
   "strokeWidth": 1,
   "cornerRadius": 16,
   "context": "File operating manual: owner, status, version, scope, links.",
   "children": [
    {
     "id": "cover-0",
     "type": "text",
     "name": "Cover 0",
     "content": "evflow Office · O2C Release 1",
     "fontFamily": "Plus Jakarta Sans",
     "fontSize": 32,
     "fontWeight": "800",
     "fill": "$textPrimary",
     "width": "fill_container",
     "textGrowth": "fixed-width"
    },
    {
     "id": "cover-1",
     "type": "text",
     "name": "Cover 1",
     "content": "Owner: Kakavi",
     "fontFamily": "Plus Jakarta Sans",
     "fontSize": 14,
     "fontWeight": "500",
     "fill": "$textPrimary",
     "width": "fill_container",
     "textGrowth": "fixed-width"
    },
    {
     "id": "cover-2",
     "type": "text",
     "name": "Cover 2",
     "content": "Status: In design",
     "fontFamily": "Plus Jakarta Sans",
     "fontSize": 14,
     "fontWeight": "500",
     "fill": "$textPrimary",
     "width": "fill_container",
     "textGrowth": "fixed-width"
    },
    {
     "id": "cover-3",
     "type": "text",
