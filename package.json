{
  "name": "evflow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel --filter=@evflow/office --filter=@evflow/api --filter=@evflow/worker",
    "build": "turbo build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @evflow/database generate",
    "db:validate": "pnpm --filter @evflow/database validate",
    "db:migrate": "pnpm --filter @evflow/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @evflow/database migrate:dev",
    "db:seed": "pnpm --filter @evflow/database seed",
    "infra:up": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yml up -d",
    "infra:down": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yml down",
    "infra:config": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yml config",
    "validate:repository": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/validate-repository.ps1",
    "db:seed:dev": "node tools/run-development-seed.cjs",
    "dev:field": "pnpm --filter @evflow/field dev",
    "db:seed:full": "node tools/run-full-development-seed.mjs",
    "db:seed:crm": "node tools/run-crm-development-seed.mjs",
    "db:seed:o2c-demo": "node tools/run-o2c-demo-seed.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.4.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "turbo": "2.5.8",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4",
    "vue-eslint-parser": "10.2.0"
  }
}
